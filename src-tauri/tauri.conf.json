{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioCycle",
  "version": "0.1.0",
  "identifier": "com.audiocycle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "AudioCycle",
        "label": "main",
        "width": 228,
        "height": 150,
        "minWidth": 228,
        "minHeight": 150,
        "maxWidth": 228,
        "maxHeight": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
